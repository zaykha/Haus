# Supabase configuration
# - NEXT_PUBLIC_* values are safe to expose to the browser
# - SUPABASE_SERVICE_ROLE_KEY must be kept server-side only (never NEXT_PUBLIC_)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used by server-only Supabase admin client (service role)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: overrides default storage bucket name used for uploads
# If not set, the app defaults to "project-images".
NEXT_PUBLIC_SUPABASE_PROJECT_IMAGES_BUCKET=

